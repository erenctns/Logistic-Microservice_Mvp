# ==========================================================
#  Logistics Microservice MVP — ortam değişkenleri
#
#  Kopyala:  cp .env.example .env
#  Sonra aşağıdaki "change_me_" ile başlayan değerleri doldur.
#
#  ⚠️  .env ASLA commit'lenmez (.gitignore'da).
#      Bu dosya yalnızca bir ŞABLON — içinde gerçek sır yok.
# ==========================================================

# ---------- PostgreSQL ----------
# HOST bir DNS adı: docker ağında "postgres" servis adına çözülür.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=logistics
POSTGRES_PASSWORD=change_me_strong_password

# Her servis kendi veritabanını kullanır (database-per-service).
# Tek container, ayrı veritabanları — üretimde ayrı sunuculara
# taşınabilir, değişen tek şey connection string olur.
AUTH_DB=auth_db
ORDER_DB=order_db
SHIPMENT_DB=shipment_db

# ---------- RabbitMQ ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=logistics
RABBITMQ_PASSWORD=change_me_strong_password
RABBITMQ_VHOST=/

# ---------- JWT ----------
# Üç servis de AYNI anahtarı kullanır: Auth token üretir,
# diğerleri imzayı kendi doğrular (Auth'a istek atmadan).
# ⚠️ En az 32 karakter olmalı.
JWT_KEY=change_me_at_least_32_characters_long_secret
JWT_ISSUER=logistics
JWT_AUDIENCE=logistics-clients
JWT_EXPIRY_MINUTES=60

# ---------- Demo kullanıcıları ----------
# İlk açılışta oluşturulan hesapların şifreleri.
# Kodda gömülü DEĞİL, buradan geliyor.
SEED_ADMIN_PASSWORD=change_me_admin_password
SEED_DEFAULT_PASSWORD=change_me_default_password

# ---------- Servis portları (host tarafı) ----------
AUTH_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
SHIPMENT_SERVICE_PORT=8083

# ---------- Uygulama ----------
ASPNETCORE_ENVIRONMENT=Development

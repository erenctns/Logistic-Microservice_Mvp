# ==========================================================
#  Smart Logistics Platform — ortam değişkenleri
#  Kopyala:  cp .env.example .env
#  ⚠️  .env ASLA commit'lenmez (.gitignore'da)
# ==========================================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=logistics
POSTGRES_PASSWORD=change_me_in_local_env

# Her servis kendi database'ini kullanır (database-per-service)
AUTH_DB=auth_db
ORDER_DB=order_db
SHIPMENT_DB=shipment_db
COURIER_DB=courier_db
DELIVERY_DB=delivery_db
NOTIFICATION_DB=notification_db

# ---------- RabbitMQ ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=logistics
RABBITMQ_DLX=logistics.dlx

# ---------- JWT ----------
# ⚠️ Üretimde en az 32 karakterlik rastgele bir değer kullan
JWT_KEY=change_me_at_least_32_characters_long_secret
JWT_ISSUER=smart-logistics
JWT_AUDIENCE=smart-logistics-clients
JWT_EXPIRY_MINUTES=60

# ---------- Servis portları ----------
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
SHIPMENT_SERVICE_PORT=8083
COURIER_SERVICE_PORT=8084
DELIVERY_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
FRONTEND_PORT=5173

# ---------- Uygulama ----------
ASPNETCORE_ENVIRONMENT=Development
SERILOG_MINIMUM_LEVEL=Information

# Outbox publisher polling aralığı (saniye)
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRY=10

# Consumer retry politikası
CONSUMER_MAX_RETRY=3
CONSUMER_RETRY_BASE_DELAY_SECONDS=1

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8080
VITE_POLL_INTERVAL_MS=3000

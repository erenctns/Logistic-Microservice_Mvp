<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Composition root: en distaki katman, her seyi birbirine baglar.
       Sadece Infrastructure'a referans verir; Application ve Domain
       oradan gecisli (transitive) olarak gelir. -->

  <ItemGroup>
    <!-- /health/ready endpoint'inin Postgres'e gercekten baglanabilmesi icin. -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />

    <!-- Sadece "dotnet ef migrations" komutunun calisabilmesi icin.
         PrivateAssets=all: calisma zamanina ve bagimli projelere tasinmaz. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AuthService.Infrastructure/AuthService.Infrastructure.csproj" />
  </ItemGroup>

</Project>

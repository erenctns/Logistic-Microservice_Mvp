<Project>

  <!-- ==========================================================
       Central Package Management (CPM)
       Paket SURUMLERI burada, tek yerde. csproj dosyalarinda
       sadece paket ADI yazilir:

         <PackageReference Include="xunit.v3" />   <- Version YOK

       20 projeye cikarken "bir proje 9.0.3'te kalmis" durumunu
       yapisal olarak imkansiz kilar.
       ========================================================== -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Test framework.
       xUnit v3, Microsoft.Testing.Platform (MTP) uzerinde calisir; eski VSTest
       dunyasinin paketleri (Microsoft.NET.Test.Sdk, xunit.runner.visualstudio,
       coverlet.collector) .NET 10'da GEREKMIYOR ve VSTest yolunu tetikleyip
       hataya sebep oluyor. Coverage da MTP'nin kendi eklentisiyle aliniyor. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- Test ICERMEYEN yardimci kutuphaneler icin: IAsyncLifetime, ICollectionFixture
         gibi tipleri verir ama calistirici (runner) getirmez, Exe zorunlulugu yok. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
  </ItemGroup>

  <!-- Assertion ve mock -->
  <ItemGroup>
    <!-- AwesomeAssertions: FluentAssertions v7'nin Apache-2.0 fork'u.
         FluentAssertions v8 ticari lisansa gecti (ADR-005). -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />

    <!-- NSubstitute: surumu simdiden sabit, ama HENUZ hicbir projede
         referans verilmedi. Ilk kullanim Step 05 handler testleri.
         (Moq kullanilmiyor — SponsorLink, ADR-005.) -->
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>

  <!-- Uygulama katmanlari -->
  <ItemGroup>
    <!-- Sadece soyut tipler (IServiceCollection, IConfiguration). Application ve
         Infrastructure katmanlari kendi DI kayitlarini kendileri tanimlasin diye. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />

    <!-- /health/ready endpoint'i Postgres'e gercekten baglanabilsin diye. -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />

    <!-- Yerlesik OpenAPI: paylasilan framework'te DEGIL, ayri paket. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <!-- CQRS hatti -->
  <ItemGroup>
    <!-- MediatR 12.5.0: Apache-2.0 olan SON surum. v13'ten itibaren ticari
         lisansa gecti ve community kullanimi bile anahtar kaydi istiyor.
         Kullandigimiz yuzey (IRequest, IRequestHandler, IPipelineBehavior)
         v14 ile neredeyse birebir ayni; anahtar derdine girmeye degmez. -->
    <PackageVersion Include="MediatR" Version="12.5.0" />

    <!-- Dogrulama kurallari handler'in icine degil, ayri validator siniflarina. -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <!-- Messaging: MassTransit v8 (ADR-008) -->
  <ItemGroup>
    <!-- 8.5.10: v8 hattinin son surumu, Apache-2.0.
         v9 ticari lisansa gecti; MediatR'da oldugu gibi son acik surumde kaliyoruz. -->
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />

    <!-- Testlerde bus'i elle kurabilmek icin (uygulama kodunda gerekmiyor:
         ASP.NET host'u bunlari zaten getiriyor). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>

  <!-- Auth Service: kimlik dogrulama ve kaliciik -->
  <ItemGroup>
    <!-- Sifre hash'leme (PBKDF2), rol yonetimi, kullanici store'u.
         Elle yazmak guvenlik acigi uretmenin en kisa yoludur. -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />

    <!-- EF Core'un PostgreSQL saglayicisi. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- Identity tablolari PascalCase gelir (AspNetUsers); konvansiyonumuz
         snake_case. Bu paket tek satirla cevirir: asp_net_users. -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />

    <!-- Sadece "dotnet ef migrations" komutu icin; calisma zamaninda kullanilmaz. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />

    <!-- Gelen istekteki JWT'yi dogrular (imza, issuer, sure). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />

    <!-- Token URETIMI. JwtSecurityTokenHandler'in yerini alan guncel API. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />

    <!-- IConfiguration'i tipli nesneye baglar: configuration["Jwt:Key"] yerine JwtOptions. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
  </ItemGroup>

  <!-- Integration test altyapisi -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.15.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />

    <!-- WebApplicationFactory: uygulamayi bellekte ayaga kaldirip gercek
         HTTP istegi atmayi saglar (port dinlemeden, tam pipeline ile). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
